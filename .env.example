# ==============================================================================
# CORTEX ERP AI-NATIVE — LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# IMPORTANT: Ne jamais committer de secrets ou clés de production dans ce fichier.
# Copier vers .env pour le développement local : cp .env.example .env

# --- Application Core (Laravel 11 / Aureus ERP) ---
APP_NAME="Cortex ERP AI-Native"
APP_ENV=local
APP_KEY=base64:CHANGEME_GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# --- Base de Données Transactionnelle (PostgreSQL 17) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cortex_dev
DB_USERNAME=cortex_user
DB_PASSWORD=cortex_local_dev_password_only

# --- Cache, Queues & Locks (Valkey 8 / Redis) ---
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Stockage Objets, Preuves & PDF (MinIO / S3) ---
AWS_ACCESS_KEY_ID=cortex_minio_admin
AWS_SECRET_ACCESS_KEY=cortex_minio_dev_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cortex-evidence
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Serveur Mail de Développement (Mailpit) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="notifications@cortex.local"
MAIL_FROM_NAME="Cortex ERP"

# --- Serveur MCP Privé (apps/cortex-mcp) ---
CORTEX_MCP_PORT=3100
CORTEX_MCP_TRANSPORT=stdio
CORTEX_API_BASE_URL=http://app:80/api/v1/agent
CORTEX_AGENT_BEARER_TOKEN=mock_dev_agent_sanctum_token_12345

# --- Routage IA (Gemini 3.7 Flash & Claude Sonnet 5) ---
# En local dev, renseigner vos clés de sandbox dans votre .env local personnel
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_MODEL=gemini-3.7-flash
ESCALATION_MODEL=claude-3-7-sonnet-20250219
