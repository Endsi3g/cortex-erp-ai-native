# ==============================================================================
# CORTEX ERP AI-NATIVE — LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# IMPORTANT: Ne jamais committer de secrets ou clés de production dans ce fichier.
# Copier vers .env pour le développement local : cp .env.example .env
#
# Stack réelle : Frappe Framework / ERPNext v15+ + MariaDB 10.11 + Valkey 8.
# Cette variable d'environnement correspond à infra/docker/docker-compose.dev.yml.

# --- Base de Données Transactionnelle (MariaDB 10.11+, standard Frappe) ---
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=_cortex_dev
DB_USERNAME=cortex_user
DB_PASSWORD=cortex_local_dev_password_only
DB_ROOT_PASSWORD=cortex_root_dev_password

# --- Cache, Queues & Locks (Valkey 8 / Redis-compatible) ---
REDIS_CACHE=redis://valkey:6379/0
REDIS_QUEUE=redis://valkey:6379/1

# --- Site Frappe local (bench new-site) ---
SITE_NAME=cortex.localhost
ADMIN_PASSWORD=admin

# --- Stockage Objets, Preuves & PDF (MinIO / S3) ---
AWS_ACCESS_KEY_ID=cortex_minio_admin
AWS_SECRET_ACCESS_KEY=cortex_minio_dev_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cortex-evidence
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Serveur Mail de Développement (Mailpit) ---
MAIL_HOST=mailpit
MAIL_PORT=1025

# --- Serveur MCP Privé (apps/cortex-mcp) — voir apps/cortex-mcp/.env.example ---
FRAPPE_URL=http://bench:8000
FRAPPE_API_KEY=dev_api_key_123
FRAPPE_API_SECRET=dev_api_secret_456
CORTEX_COMPANY=CineRental Montreal

# --- Routage IA (Gemini 3.7 Flash & Claude Sonnet 5) ---
# En local dev, renseigner vos clés de sandbox dans votre .env local personnel.
# Ne jamais coller une clé réelle directement dans un message de chat/agent —
# écrire ce fichier localement via le terminal.
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_MODEL=gemini-3.7-flash
