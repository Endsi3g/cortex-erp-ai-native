      "fieldtype": "Section Break",
      "label": "Taxes de vente"
    },
    {
      "fieldname": "apply_taxes",
      "fieldtype": "Check",
      "label": "Appliquer les taxes",
      "default": "1",
      "description": "Décochez seulement si la société n'est pas inscrite aux fichiers de taxes."
    },
    {
      "fieldname": "tps_rate",
      "fieldtype": "Float",
      "label": "TPS (%)",
      "default": "5",
