    {
      "fieldname": "cb_tax",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "tps_number",
      "fieldtype": "Data",
      "label": "Numéro de TPS"
    },
    {
      "fieldname": "tvq_number",
      "fieldtype": "Data",
      "label": "Numéro de TVQ"
    },
    {
      "fieldname": "sb_billing",
      "fieldtype": "Section Break",
      "label": "Acompte et paiement"
    },
    {
      "fieldname": "deposit_percent",
      "fieldtype": "Float",
      "label": "Acompte à la réservation (%)",
      "default": "30",
      "precision": "2",
      "description": "0 = aucune facture d'acompte. Calculé sur le sous-total, taxes ajoutées."
    },
    {
      "fieldname": "cb_billing",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "invoice_due_days",
      "fieldtype": "Int",
      "label": "Échéance des factures (jours)",
      "default": "0",
      "description": "0 = payable à l'émission."
    },
    {
      "fieldname": "sb_late",
      "fieldtype": "Section Break",
      "label": "Frais de retard (décidés par la société)"
    },
    {
      "fieldname": "late_fee_enabled",
      "fieldtype": "Check",
      "label": "Facturer les retards",
      "default": "0",
      "description": "Désactivé par défaut : la société choisit sa règle."
    },
    {
      "fieldname": "late_fee_grace_minutes",
      "fieldtype": "Int",
      "label": "Délai de grâce (minutes)",
      "default": "60",
      "depends_on": "late_fee_enabled"
    },
    {
      "fieldname": "cb_late",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "late_fee_percent",
      "fieldtype": "Float",
      "label": "Frais par jour de retard (% du tarif journalier)",
      "default": "100",
      "precision": "2",
      "depends_on": "late_fee_enabled"
    },
    {
      "fieldname": "late_fee_cap_days",
      "fieldtype": "Float",
      "label": "Plafond (jours facturables, 0 = aucun)",
      "default": "0",
      "precision": "2",
      "depends_on": "late_fee_enabled"
    },
    {
      "fieldname": "sb_quotes",
      "fieldtype": "Section Break",
      "label": "Devis partagés avec les clients"
    },
    {
      "fieldname": "quote_hold_enabled",
      "fieldtype": "Check",
      "label": "Un devis retient le matériel dans la disponibilité",
      "default": "1",
      "description": "Dès qu'un devis est créé, les unités demandées sont retenues (visibles dans la grille) pour qu'un autre devis ou une autre réservation ne les prenne pas. La retenue expire seule."
    },
    {
      "fieldname": "quote_hold_hours",
      "fieldtype": "Int",
      "label": "Durée de la retenue (heures)",
      "default": "72"
    },
    {
      "fieldname": "auto_reserve_on_accept",
      "fieldtype": "Check",
      "label": "Réserver automatiquement quand le client accepte",
      "default": "0",
      "description": "Si la disponibilité est confirmée par le serveur au moment de l'acceptation, le matériel est réservé sans intervention (au nom de la personne qui a envoyé le devis). Sinon, l'équipe est avertie et réserve à la main. Désactivé par défaut."
    },
    {
      "fieldname": "sb_online_payment",
      "fieldtype": "Section Break",
      "label": "Paiement de l'acompte en ligne"
    },
    {
      "fieldname": "online_payment_enabled",
      "fieldtype": "Check",
      "label": "Permettre de payer l'acompte dans le portail",
      "default": "0",
      "description": "Nécessite un compte Stripe de la société (clés ci-dessous). Sans clés, le portail affiche seulement les instructions de paiement."
    },
    {
      "fieldname": "stripe_secret_key",
      "fieldtype": "Password",
      "label": "Clé secrète Stripe",
      "description": "Stockée chiffrée, jamais envoyée au navigateur."
    },
    {
      "fieldname": "stripe_webhook_secret",
      "fieldtype": "Password",
      "label": "Secret du webhook Stripe",
      "description": "Adresse du webhook à saisir dans Stripe : /api/method/cortex_rental.api.v1.quote_share.stripe_webhook (événement checkout.session.completed)."
    },
    {
      "fieldname": "cb_online_payment",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "payment_instructions",
      "fieldtype": "Small Text",
      "label": "Instructions de paiement manuel",
      "description": "Affichées au client après l'acceptation (ex. virement Interac, chèque). Facultatif."
    },
    {
      "fieldname": "sb_damage",
      "fieldtype": "Section Break",
      "label": "Dommages et pertes"
    },
    {
      "fieldname": "damage_billing_enabled",
      "fieldtype": "Check",
      "label": "Facturer les dommages et les pertes à la clôture",
      "default": "0",
      "description": "Désactivé par défaut : chaque société décide. Matériel abîmé : coût de réparation estimé au retour. Matériel manquant : valeur de remplacement du catalogue × le pourcentage ci-contre."
    },
    {
      "fieldname": "missing_billing_percent",
      "fieldtype": "Float",
      "label": "Matériel manquant : % de la valeur de remplacement",
      "default": "100"
    },
    {
      "fieldname": "sb_accounts",
      "fieldtype": "Section Break",
      "label": "Plan de comptes (pour les écritures comptables)",
