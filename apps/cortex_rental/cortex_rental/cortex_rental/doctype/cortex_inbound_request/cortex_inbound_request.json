{
  "name": "Cortex Inbound Request",
  "doctype": "DocType",
  "module": "Cortex Rental",
  "custom": 0,
  "autoname": "CR-INB-.YYYY.-.#####",
  "naming_rule": "Expression (old style)",
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "source_channel",
      "fieldtype": "Select",
      "label": "Source Channel",
      "options": "Email\nPDF Upload\nWeb Portal\nAPI Intake",
      "default": "Email",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sender_email",
      "fieldtype": "Data",
      "label": "Sender Email",
      "in_list_view": 1
    },
    {
      "fieldname": "subject",
      "fieldtype": "Data",
      "label": "Subject",
      "in_list_view": 1
    },
    {
      "fieldname": "raw_payload",
      "fieldtype": "Code",
      "options": "JSON",
      "label": "Raw Payload"
    },
    {
      "fieldname": "structured_data",
      "fieldtype": "Code",
      "options": "JSON",
      "label": "Structured Extracted Data"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Received\nProcessing\nProcessed\nRejected",
      "default": "Received",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "extracted_transaction",
      "fieldtype": "Link",
      "label": "Created Rental Transaction",
      "options": "Cortex Rental Transaction",
      "read_only": 1
    },
    {
      "fieldname": "processed_by",
      "fieldtype": "Data",
      "label": "Processed By (Agent / User)"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Rental Operator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    },
    {
      "role": "Agent Service Account",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0
    }
  ]
}
