  "fields": [
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Company",
      "options": "Company",
      "reqd": 1,
      "description": "Déterminée par le serveur : jamais acceptée du client, comme pour tous les champs de société."
    },
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "User",
      "options": "User",
      "reqd": 1,
      "description": "Toujours la personne connectée à la création : une conversation appartient à une seule identité humaine."
    },
    {
      "fieldname": "agent_profile",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Agent Profile",
      "reqd": 1,
      "description": "Déterminé par le serveur selon la page (par exemple disponibilité ou prise en charge) : jamais un choix du client."
    },
    {
      "fieldname": "onyx_chat_session_id",
      "fieldtype": "Data",
      "label": "Onyx Chat Session ID",
      "description": "Identifiant de la session côté assistant, une fois un vrai serveur connecté. Vide tant qu'il n'est pas configuré."
    },
    {
      "default": "fr-CA",
      "fieldname": "locale",
      "fieldtype": "Select",
      "label": "Locale",
      "options": "fr-CA\nen-CA",
      "reqd": 1
    },
    {
      "default": "Active",
      "fieldname": "state",
      "fieldtype": "Select",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "State",
      "options": "Active\nClosed\nHidden"
    },
    {
      "fieldname": "pinned_context",
      "fieldtype": "Link",
      "label": "Pinned Context Snapshot",
      "options": "Cortex Chat Context Snapshot",
      "description": "Défini par « épingler le contexte », effacé par « effacer le contexte ». Quand il est défini, ce contexte remplace celui du prochain message."
    },
    {
      "fieldname": "last_context_hash",
      "fieldtype": "Data",
      "label": "Last Context Hash",
      "description": "Empreinte du dernier contexte validé : permet au client de détecter un contexte périmé sans renvoyer toutes les données."
    },
    {
      "fieldname": "started_at",
      "fieldtype": "Datetime",
      "label": "Started At",
      "reqd": 1
    },
    {
      "fieldname": "last_message_at",
      "fieldtype": "Datetime",
      "label": "Last Message At"
    },
    {
      "fieldname": "retention_until",
      "fieldtype": "Datetime",
      "label": "Retention Until",
      "description": "Non renseigné pour l'instant : aucune politique de conservation n'est encore en place, donc aucune garantie n'est affichée."
    }
