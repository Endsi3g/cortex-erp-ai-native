# Cortex MCP Server Configuration
PORT=3100
CORTEX_MCP_TRANSPORT=http # 'http' (Streamable HTTP) or 'stdio' (Local CLI debugging)
CORTEX_API_BASE_URL=http://localhost:8080/api/v1
CORTEX_API_TOKEN=cortex_agent_service_token_sample_secret
CORTEX_DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
CORTEX_HTTP_TIMEOUT_MS=10000
CORTEX_MAX_READ_RETRIES=2
LOG_LEVEL=info
